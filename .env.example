# ---------------------------------------------------------------
# MÚRÀ environment. Copy to .env.local and fill in.
# Never commit real values. Variables prefixed NEXT_PUBLIC_ are
# visible in the browser — never put secrets in them.
# ---------------------------------------------------------------

# Public site URL (canonical links, sitemap, share images).
# On Netlify this falls back to the site's own URL automatically; set it once you
# have a custom domain, e.g. https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# Seasonal theme: default | valentines | easter | back-to-school | christmas
NEXT_PUBLIC_SEASON=default

# ---------------------------------------------------------------
# Server-only (never prefix these with NEXT_PUBLIC_)
# ---------------------------------------------------------------

# Payments stay off until Phase 5 (Flutterwave) is connected and verified.
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# Signs download links. Use a long random value in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DOWNLOAD_TOKEN_SECRET=
DOWNLOAD_LINK_TTL_DAYS=7
MAX_DOWNLOADS_PER_ITEM=20

# Storage: "netlify-blobs" (detected automatically on Netlify) or "file" (local/Node server).
# MURA_STORAGE=netlify-blobs

# Local file storage — both must be OUTSIDE /public and never committed.
# On Netlify, upload product files with: npm run upload-file -- <fileKey> <path>
# Product files are looked up by each product's fileKey, e.g.
#   private/products/student-reset/mura-student-reset.pdf
PRODUCT_FILES_DIR=private/products
MURA_DATA_DIR=.data

# Email (SMTP). Gmail works: turn on 2-Step Verification for the account,
# create an App Password, and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mura.creates@gmail.com
SMTP_PASS=
EMAIL_FROM="MÚRÀ <mura.creates@gmail.com>"

# Company inbox for contact messages and order notifications.
MURA_INBOX_EMAIL=mura.creates@gmail.com

# Campaigns: name one from lib/season/campaigns.ts to switch it on without a code
# change. It still only runs between its start and end dates. Leave empty for none.
NEXT_PUBLIC_ACTIVE_CAMPAIGN=
