# ---------------------------------------------------------------
# MÚRÀ environment. Copy to .env.local and fill in.
# Never commit real values. Variables prefixed NEXT_PUBLIC_ are
# visible in the browser — never put secrets in them.
# ---------------------------------------------------------------

# Public site URL (canonical links, sitemap, share images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Seasonal theme: default | valentines | easter | back-to-school | christmas
NEXT_PUBLIC_SEASON=default

# ---------------------------------------------------------------
# Server-only (never prefix these with NEXT_PUBLIC_)
# ---------------------------------------------------------------

# Payments stay off until Phase 5 (Flutterwave) is connected and verified.
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# Signs download links. Use a long random value in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DOWNLOAD_TOKEN_SECRET=
DOWNLOAD_LINK_TTL_DAYS=7
MAX_DOWNLOADS_PER_ITEM=20

# Private storage — both must be OUTSIDE /public and never committed.
# Product files are looked up by each product's fileKey, e.g.
#   private/products/student-reset/mura-student-reset.pdf
PRODUCT_FILES_DIR=private/products
MURA_DATA_DIR=.data

# Email (SMTP). Gmail works: turn on 2-Step Verification for the account,
# create an App Password, and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="MÚRÀ <your-address@gmail.com>"

# Company inbox for contact messages and order notifications.
MURA_INBOX_EMAIL=
