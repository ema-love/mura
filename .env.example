# ---------------------------------------------------------------
# MÚRÀ environment. Copy to .env.local and fill in.
# Never commit real values. Variables prefixed NEXT_PUBLIC_ are
# visible in the browser — never put secrets in them.
# ---------------------------------------------------------------

# Public site URL (canonical links, sitemap, share images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Seasonal theme: default | valentines | easter | back-to-school | christmas
NEXT_PUBLIC_SEASON=default
